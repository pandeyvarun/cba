# Only the runnable app and complete checksummed snapshot enter the build context.
**
!Dockerfile
!.dockerignore
!package.json
!package-lock.json
!server.mjs
!server/*.mjs
server/*.test.mjs
server/*.spec.mjs
!public/*.html
!public/*.js
!public/*.css
!public/assets/*.svg
!public/assets/*.woff2
!config/taxonomy.json
!config/taxonomy-source.yaml
!data/snapshot-manifest.json
!data/snapshot-[0-9][0-9][0-9].bin
!container/healthcheck.mjs
