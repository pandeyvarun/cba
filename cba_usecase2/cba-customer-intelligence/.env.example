# Copy to .env (never commit it). Only set what you use.
ANTHROPIC_API_KEY=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=voc-research/0.1
SERVICENOW_INSTANCE=yourbank.service-now.com
SERVICENOW_USER=
SERVICENOW_PASSWORD=
JIRA_SITE=https://yourcompany.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=

# API service (ci serve)
CI_API_KEY=                 # required for POST endpoints; generate e.g. `python -c "import secrets;print(secrets.token_urlsafe(32))"`
CI_ALLOW_JIRA_PUSH=         # set to 1 ONLY when real Jira writes are approved
CI_CORS_ORIGINS=            # comma-separated origins allowed to call the API from a browser
